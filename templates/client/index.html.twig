{% extends 'base.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>👥 Liste des clients</h2>
        <a href="{{ path('client_create') }}" class="btn btn-success">➕ Ajouter un client</a>
    </div>

    {% if clients is not empty %}
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Raison sociale</th>
                <th>Ville</th>
                <th>Pays</th>
                <th>Représentant légal</th>
                <th>Email RL</th>
                <th>Téléphone RL</th>
                <th>Actif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for client in clients %}
            <tr>
                <td>{{ client.raisonSociale }}</td>
                <td>{{ client.ville }}</td>
                <td>{{ client.pays }}</td>
                <td>{{ client.nomPrenomRepresentant }}</td>
                <td>{{ client.emailRepresentant }}</td>
                <td>{{ client.telephoneRepresentant }}</td>
                <td>
                    {% if client.actif %}
                        <span class="badge bg-success">Oui</span>
                    {% else %}
                        <span class="badge bg-secondary">Non</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('client_edit', {'id': client.id}) }}" class="btn btn-sm btn-warning">✏️ Modifier</a>

                    <form method="post" action="{{ path('client_delete', {'id': client.id}) }}" style="display:inline-block;" onsubmit="return confirm('Confirmer la suppression ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-client' ~ client.id) }}">
                        <button class="btn btn-sm btn-danger" type="submit">🗑️ Supprimer</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p class="text-muted">Aucun client trouvé.</p>
    {% endif %}
</div>
{% endblock %}
