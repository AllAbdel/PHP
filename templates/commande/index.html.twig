{% extends 'base.html.twig' %}

{% block title %}Liste des commandes{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="mb-4">📦 Liste des commandes</h2>

            <a href="{{ path('commande_create') }}" class="btn btn-primary mb-3">➕ Nouvelle commande</a>

            {% if commandes is not empty %}
                <ul class="list-group">
                    {% for commande in commandes %}
                        <li class="list-group-item">
                            Client : <strong>{{ commande.client.name }}</strong> |
                            Produit : <strong>{{ commande.product.name }}</strong> |
                            Quantité : {{ commande.quantity }} |
                            Date : {{ commande.createdAt|date('d/m/Y H:i') }}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-muted">Aucune commande enregistrée.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
