{% extends 'base.html.twig' %}

{% block title %}Liste des factures{% endblock %}

{% block body %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📋 Factures</h2>
    <a href="{{ path('facture_create') }}" class="btn btn-success">➕ Ajouter une facture</a>
  </div>

  {% if factures is not empty %}
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Client</th>
          <th>Application</th>
          <th>PDF</th>
          <th>Date</th>
          <th>Échéance</th>
          <th>Statut</th>
          <th>HT</th>
          <th>TVA</th>
          <th>TTC</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for f in factures %}
          <tr>
            <td>{{ f.client.raisonSociale }}</td>
            <td>{{ f.application.nom }}</td>
            <td>
              {% if f.file %}
                <a href="{{ asset('uploads/' ~ f.file) }}" target="_blank" class="btn btn-sm btn-outline-primary">📎 Voir PDF</a>
              {% else %}
                <span class="text-muted">-</span>
              {% endif %}
            </td>
            <td>{{ f.date|date('d/m/Y') }}</td>
            <td>{{ f.dateEcheance|date('d/m/Y') }}</td>
            <td><span class="badge bg-info">{{ f.statut }}</span></td>
            <td>{{ f.montantHT }} €</td>
            <td>{{ f.montantTVA }} €</td>
            <td>{{ f.montantTTC }} €</td>
            <td>
              <a href="{{ path('facture_edit', {'id': f.id}) }}" class="btn btn-sm btn-warning">✏️</a>
              <form method="post" action="{{ path('facture_delete', {'id': f.id}) }}" style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-facture' ~ f.id) }}">
                <button class="btn btn-sm btn-danger">🗑️</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="text-muted">Aucune facture enregistrée.</p>
  {% endif %}
</div>
{% endblock %}
