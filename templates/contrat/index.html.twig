{% extends 'base.html.twig' %}

{% block title %}Liste des contrats{% endblock %}

{% block body %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📋 Liste des contrats</h2>
    <a href="{{ path('contrat_create') }}" class="btn btn-success">➕ Ajouter un contrat</a>
  </div>

  {% if contrats is not empty %}
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Client</th>
          <th>Application</th>
          <th>PDF</th>
          <th>Statut</th>
          <th>Créé le</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for contrat in contrats %}
          <tr>
            <td>{{ contrat.client.raisonSociale }}</td>
            <td>{{ contrat.application.nom }}</td>
            <td>
              {% if contrat.file %}
                <a href="{{ asset('uploads/' ~ contrat.file) }}" target="_blank" class="btn btn-sm btn-outline-primary">📎 Voir PDF</a>
              {% else %}
                <span class="text-muted">Aucun</span>
              {% endif %}
            </td>
            <td>
              <span class="badge bg-info">{{ contrat.statut }}</span>
            </td>
            <td>{{ contrat.createdAt|date('d/m/Y H:i') }}</td>
            <td>
              <a href="{{ path('contrat_edit', {'id': contrat.id}) }}" class="btn btn-sm btn-warning">✏️</a>
              <form method="post" action="{{ path('contrat_delete', {'id': contrat.id}) }}" style="display:inline-block;" onsubmit="return confirm('Confirmer la suppression ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-contrat' ~ contrat.id) }}">
                <button class="btn btn-sm btn-danger">🗑️</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="text-muted">Aucun contrat enregistré.</p>
  {% endif %}
</div>
{% endblock %}
